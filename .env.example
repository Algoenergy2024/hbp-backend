# Server
PORT=4000
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://hbp:hbp_dev_local@localhost:5432/hbp_dev
# Leave false for local Postgres / Docker Compose. Some hosted providers
# (over a public endpoint) need this set to true — see README.
DATABASE_SSL=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d

# Live market data connectors
ELEXON_BMRS_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# National Gas Transmission's public data portal — System Average Price
# (the day-ahead gas price equivalent to Elexon's system prices), no API
# key required. Same base URL the portal's own UI downloads from.
NATIONALGAS_BASE_URL=https://data.nationalgas.com

# UK ETS has no free structured API for auction/secondary-market carbon prices.
# Leave UKETS_AUCTION_URL unset to run on the curated carbon-price table (default,
# clearly flagged as "curated" in API responses). Set it only if/when your org has
# a licensed feed (e.g. ICE UK ETS auction platform, or a data vendor) to pull from.
UKETS_AUCTION_URL=

MARKET_REFRESH_CRON=*/30 * * * *
